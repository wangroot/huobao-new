# Copy to .env. Configure API keys in the application.
HUOBAO_IMAGE=huobao-drama-custom:4.0.9-fixes
HUOBAO_VERSION=4.0.9-fixes
HUOBAO_BIND=127.0.0.1
HUOBAO_PORT=5679
HUOBAO_DATA_PATH=./deploy-data
TZ=Asia/Shanghai
# Public HTTPS origin used by the model provider to fetch local reference media.
# Leave empty when reference media already uses publicly accessible URLs.
PUBLIC_BASE_URL=

# Optional npm registry override for restricted networks.
NPM_REGISTRY=https://registry.npmjs.org
